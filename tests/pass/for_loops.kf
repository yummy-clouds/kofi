fc main() {
    var sum: int = 0
    for var i: int = 1; i <= 10; i = i + 1 {
        sum = sum + i
    }
    printf("", sum, "\n")

    var count: int = 5
    for count > 0 {
        count = count - 1
    }
    printf("", count, "\n")

    for {
        printf("loop break\n")
        break
    }
}
