fc fib(n: int) => int {
    if n <= 1 {
        return n
    }
    var a: int = 0
    var b: int = 1
    for var i: int = 2; i <= n; i = i + 1 {
        var temp: int = a + b
        a = b
        b = temp
    }
    return b
}

fc main() {
    printf("Fibonacci numbers from 0 to 10:\n")
    for var i: int = 0; i <= 10; i = i + 1 {
        printf("", fib(i), "\n")
    }
}
